{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=agricheck_v3;User=agricheck_v3;Password=agricheck_v3_dev;",
    "V2Connection": "Server=localhost;Port=3306;Database=agricheck_dev;User=root;Password=;"
  },
  "V2": {
    "PublicRoot": "C:/xampp/htdocs/agricheck/public"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Jwt": {
    "Issuer": "AgriCheckV3",
    "Audience": "AgriCheckV3",
    "SecretKey": "CHANGE_ME_USE_ENV_OR_USER_SECRETS_IN_PRODUCTION",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/agricheck-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicBaseUrl": "http://localhost:5173"
  },
  "PayMongo": {
    "ApiKey": "",
    "WebhookSecret": ""
  }
}
