# AgriCheck V3 API — environment variables (optional overrides)
# Copy values into Railway Variables. Do not commit real secrets.

ASPNETCORE_ENVIRONMENT=Production

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agricheck_v3
MYSQL_USER=agricheck_v3
MYSQL_PASSWORD=agricheck_v3_dev
# MYSQL_SSL_MODE=Preferred

Jwt__SecretKey=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_KEY
Jwt__Issuer=AgriCheckV3
Jwt__Audience=AgriCheckV3

Cors__AllowedOrigins__0=https://dimgrey-hummingbird-677957.hostingersite.com
App__PublicBaseUrl=https://dimgrey-hummingbird-677957.hostingersite.com
# Optional dedicated key for signed transport QR payloads (falls back to Jwt__SecretKey)
# App__QrSigningKey=CHANGE_ME_TRANSPORT_QR_SIGNING_KEY
UPLOADS_ROOT=/app/uploads

# Local fallback if MYSQL_* is not set:
# ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=agricheck_v3;User=agricheck_v3;Password=agricheck_v3_dev;
