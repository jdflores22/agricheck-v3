# AgriCheck V3 API — environment variables (optional overrides)
# Copy to appsettings.Development.json or use dotnet user-secrets

ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=agricheck_v3;User=agricheck_v3;Password=agricheck_v3_dev;
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# JWT (Phase P1)
Jwt__SecretKey=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_KEY
Jwt__Issuer=AgriCheckV3
Jwt__Audience=AgriCheckV3

# Redis (Phase P1)
# Redis__ConnectionString=localhost:6379
