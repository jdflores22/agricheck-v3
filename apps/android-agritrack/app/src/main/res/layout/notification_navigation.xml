<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nav_notification_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nav_notification_maneuver_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/nav_notification_maneuver_icon_desc"
            android:src="@drawable/ic_notif_maneuver_forward" />

        <TextView
            android:id="@+id/nav_notification_maneuver"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/nav_notification_offline_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#33FBBF24"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="@string/nav_notification_offline_status"
        android:textColor="#FDE68A"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/nav_notification_traffic_strip"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/nav_notification_traffic_strip_desc"
        android:scaleType="fitXY" />
</LinearLayout>
